
{
  "manifest_version": 3,
  "name": "LockedIn Assistant",
  "version": "1.0",
  "description": "Stay locked in. Track tasks, sessions, and block distractions.",

  "permissions": [
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://lockedin-6k2g.onrender.com/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],

  "action": {
    "default_popup": "popUp.html"
  },

  "background": {
    "service_worker": "backGround.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["roastPopUp.css"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["roastPopUp.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
