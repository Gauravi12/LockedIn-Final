# Copy these values into your shell environment before starting the backend.
# Never commit a real .env file.

# MySQL
DB_USERNAME=root
DB_PASSWORD=change-me

# Groq (OpenAI-compatible) API key: https://console.groq.com/keys
GROQ_API_KEY_LOCKEDIN=gsk_replace_me

# Gmail SMTP. Use a 16-character app password, not your account password.
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=replace_with_gmail_app_password

# HS256 signing key. Must be at least 32 characters.
JWT_SECRET=replace_with_a_random_string_at_least_32_chars
